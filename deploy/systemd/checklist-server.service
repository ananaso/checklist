[Unit]
Description=Checklist server
After=network-online.target
Wants=network-online.target

[Service]
# Built and installed into /srv/checklist/server by deploy/deploy.sh.
ExecStart=/srv/checklist/server/bin/server --listen 127.0.0.1:8090 --database /var/lib/checklist/checklist.sqlite

# Run as a throwaway unprivileged user; the SQLite database in
# /var/lib/checklist is the only thing it can write.
DynamicUser=yes
StateDirectory=checklist
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

Restart=on-failure

[Install]
WantedBy=multi-user.target
