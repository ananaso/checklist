# Restarts checklist-server.service after deploy/deploy.sh installs a new
# build (it writes this stamp file last), so the deploy user needs no sudo
# rights.

[Unit]
Description=Restart checklist server after a deploy

[Path]
PathChanged=/srv/checklist/server/.deployed
Unit=checklist-server-restart.service

[Install]
WantedBy=multi-user.target
