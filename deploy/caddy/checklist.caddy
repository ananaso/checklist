# Caddy site blocks for the checklist web app and its login service.
#
# Replace example.com with your domain, then add this to your Caddyfile
# (or `import` it from there) and run `sudo systemctl reload caddy`.

# Authelia's login page. Its own address, so the session cookie can cover the
# checklist site and any other site you later put behind it.
auth.example.com {
	reverse_proxy 127.0.0.1:9091
}

checklist.example.com {
	# Icons and the manifest stay public: iOS fetches them for "Add to Home
	# Screen" without the login cookie. Everything else requires a logged-in
	# Authelia session.
	@private not path /manifest.json /favicon.png /icons/*
	forward_auth @private 127.0.0.1:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}

	# The checklist server: calls from the app, and the WebSocket that tells
	# it about changes.
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	# The Flutter web build, uploaded by deploy/deploy.sh.
	handle {
		root * /srv/checklist/web
		# Flutter's file names don't change between builds, so make browsers
		# check for a newer copy on every load instead of caching it.
		header Cache-Control "no-cache"
		file_server
	}

	encode zstd gzip
}
